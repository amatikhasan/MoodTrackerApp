<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="au.edu.utas.sakther.assignment2">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/list"
        android:label="@string/app_name"
        android:roundIcon="@drawable/list"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity android:name="au.edu.utas.sakther.assignment2.ui.ViewJournal"></activity>
        <activity android:name="au.edu.utas.sakther.assignment2.ui.MainActivity" />
        <activity android:name="au.edu.utas.sakther.assignment2.ui.CreateJournal" />
        <activity android:name="au.edu.utas.sakther.assignment2.ui.MyJournal">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="au.edu.utas.sakther.assignment2.ui.MoodList" />
        <activity android:name="au.edu.utas.sakther.assignment2.ui.MoodTracker" />
    </application>

</manifest>